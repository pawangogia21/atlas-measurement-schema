<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.atlas</groupId>
    <artifactId>atlas-measurement-schema-kotlin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>atlas-measurement-schema-kotlin</name>
    <description>Kotlin JVM 11 artifact (AT-16): the port of the tolerance function (reads tolerance-profile.json, verified
        against the same vectors as the Java reference and the Swift port) plus the generated types, which come in
        transitively from atlas-measurement-schema-types (jsonschema2pojo, usable from Kotlin as they are). The artifact
        carries every released tolerance profile as a resource (tolerance/&lt;version&gt;/tolerance-profile.json, selected by
        ToleranceProfile.bundled(version)) and tolerance/manifest.json (version, sha256 per file, toleranceProfileVersion).
        The vectors are the separate atlas-measurement-vectors artifact of the same version: a Kit declares it as a test
        dependency and checks its vectors/manifest.json.
    </description>

    <properties>
        <kotlin.version>2.0.21</kotlin.version>
        <kotlin.compiler.jvmTarget>11</kotlin.compiler.jvmTarget>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <jackson.version>2.18.11</jackson.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <!-- the jsonschema2pojo types (AT-16 sub-task I); same release, so ${project.version} -->
            <groupId>com.atlas</groupId>
            <artifactId>atlas-measurement-schema-types</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/../tolerance</directory>
                <targetPath>tolerance</targetPath>
                <includes>
                    <include>*/tolerance-profile.json</include>
                    <include>tolerance-profile.schema.json</include>
                </includes>
            </resource>
            <resource>
                <!-- the release version replaces @project.version@ -->
                <directory>${project.basedir}/../tolerance</directory>
                <targetPath>tolerance</targetPath>
                <filtering>true</filtering>
                <includes>
                    <include>manifest.json</include>
                </includes>
            </resource>
        </resources>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals><goal>test-compile</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/pawangogia21/atlas-measurement-schema</url>
        </repository>
    </distributionManagement>
</project>
