<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.atlas</groupId>
    <artifactId>atlas-measurement-schema-types</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>atlas-measurement-schema-types</name>
    <description>Java (JVM 11) types generated by jsonschema2pojo from ../json-schema/v1 (AT-16): LiveMeasurement,
        clientCapture and the batch request. Schema-derived types only; the JSON Schema stays the source of truth and
        nothing generated is committed. Consumers (server intake, the Kotlin artifact) pin this jar by version.
        Strictness: unknown properties fail unless the caller's ObjectMapper turns that off, so build mappers with
        StrictMapper.create().
    </description>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <jackson.version>2.18.11</jackson.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.26.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jsonschema2pojo</groupId>
                <artifactId>jsonschema2pojo-maven-plugin</artifactId>
                <version>1.2.1</version>
                <configuration>
                    <sourceDirectory>${project.basedir}/../json-schema/v1</sourceDirectory>
                    <includes>
                        <include>*.schema.json</include>
                    </includes>
                    <targetPackage>com.atlas.measurement.schema.v1</targetPackage>
                    <sourceType>jsonschema</sourceType>
                    <annotationStyle>jackson2</annotationStyle>
                    <useTitleAsClassname>true</useTitleAsClassname>
                    <includeAdditionalProperties>false</includeAdditionalProperties>
                    <includeJsr303Annotations>false</includeJsr303Annotations>
                    <includeJsr305Annotations>false</includeJsr305Annotations>
                    <includeConstructors>false</includeConstructors>
                    <includeHashcodeAndEquals>true</includeHashcodeAndEquals>
                    <includeToString>true</includeToString>
                    <dateTimeType>java.time.Instant</dateTimeType>
                    <useDoubleNumbers>true</useDoubleNumbers>
                    <useLongIntegers>false</useLongIntegers>
                    <initializeCollections>false</initializeCollections>
                    <useJakartaValidation>false</useJakartaValidation>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/pawangogia21/atlas-measurement-schema</url>
        </repository>
    </distributionManagement>
</project>
